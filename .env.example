# MindSmiths Lead Intelligence configuration
# Copy this file to .env and fill in only what you need.

# Optional: SerpAPI Google Maps provider (https://serpapi.com)
# Without a key, use the free OpenStreetMap provider or Demo mode.
SERPAPI_KEY=

# Optional overrides
DB_PATH=data/mindsmiths.db
LOG_PATH=logs/mindsmiths.log
REQUEST_TIMEOUT=15
REQUEST_DELAY=1.0
MAX_WORKERS=4
OVERPASS_URL=https://overpass-api.de/api/interpreter
DEFAULT_CITY=Chennai
DEFAULT_MIN_FOLLOWERS=2000
DEFAULT_ACTIVE_DAYS=30

# Free public web-presence search (DuckDuckGo HTML) for social links, phones and emails.
# Uses SerpAPI's Google engine automatically when SERPAPI_KEY is set.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_DELAY=1.2
WEB_SEARCH_RESULTS=10
WEB_SEARCH_ENGINE=auto
