# MindSmiths Lead Intelligence configuration
# Copy this file to .env and fill in only what you need.

# Optional: SerpAPI Google Maps provider (https://serpapi.com)
# Without a key, use the free OpenStreetMap provider or Demo mode.
SERPAPI_KEY=

# Optional overrides
DB_PATH=data/mindsmiths.db
LOG_PATH=logs/mindsmiths.log
REQUEST_TIMEOUT=15
REQUEST_DELAY=1.0
MAX_WORKERS=4
OVERPASS_URL=https://overpass-api.de/api/interpreter
DEFAULT_CITY=Chennai
DEFAULT_MIN_FOLLOWERS=2000
DEFAULT_ACTIVE_DAYS=30

# Free public web-presence search (DuckDuckGo HTML) for social links, phones and emails.
# Uses SerpAPI's Google engine automatically when SERPAPI_KEY is set.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_DELAY=1.2
WEB_SEARCH_RESULTS=10
WEB_SEARCH_ENGINE=auto

# Freelance opportunity sources. Only public APIs are used by default.
# No key is required for Freelancer.com, Remotive or Arbeitnow.
FREELANCER_API_URL=https://www.freelancer.com/api/projects/0.1/projects/active/
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
FREELANCE_FETCH_DETAILS=false

# Upwork requires an OAuth access token from https://developers.upwork.com/.
# Leave empty to keep the Upwork connector disabled. Never commit this token.
UPWORK_ACCESS_TOKEN=
UPWORK_GRAPHQL_URL=https://api.upwork.com/graphql

# Quotation branding shown on generated HTML/PDF quotes.
COMPANY_CONTACT=sales@mindsmiths.example
COMPANY_WEBSITE=https://mindsmiths.example
